<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_glass_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/card_bg_deepgreen" />

    <ImageView
        android:id="@+id/iv_leaf"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|top"
        android:layout_margin="6dp"
        android:rotation="200"
        android:alpha="0.3"
        android:src="@drawable/ic_leaf" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_countdown_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="距离目标"
            android:maxLines="1"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_on_glass_secondary" />

        <TextView
            android:id="@+id/tv_countdown_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="99 天"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_on_glass" />
    </LinearLayout>
</FrameLayout>
